# Public routing and isolated host ports
APP_HOST=ailiteracy.ng
LEGACY_HOST=ai-literacy.65-109-8-231.sslip.io
APP_PORT=3100
POSTGRES_PORT=5434
REDIS_PORT=6381

# Generate unique production values; never reuse these examples as secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ailiteracy:replace-with-a-long-random-password@db:5432/ailiteracy?schema=public&connection_limit=10
REDIS_URL=redis://redis:6379
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://ailiteracy.ng
ADMIN_TRIGGER_SECRET=replace-with-a-separate-long-random-secret
SEED_PASSWORD=replace-with-a-unique-demo-account-password

# Public launch must use live integrations and must not expose demo access.
INTEGRATION_MODE=live
ALLOW_MOCK_CHECKOUT=false
FREE_ENROLLMENT_ENABLED=false
SHOW_DEMO_CREDENTIALS=false
ADMIN_PREVIEW_ENABLED=false

# Optional Google sign-in. Leave both blank to hide it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Signup protection. Configure both together.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional plan wording enhancement. Curated plans work without it.
AI_PERSONALIZATION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=AI Literacy <noreply@learn.ailiteracy.ng>

# Payments. Configure and test at least one complete provider pair.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Optional analytics
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional web-push reminders
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:learn@ailiteracy.ng
