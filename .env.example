DATABASE_URL=postgresql://ailiteracy:local-dev-password@localhost:5432/ailiteracy?schema=public&connection_limit=10
POSTGRES_PASSWORD=local-dev-password
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth. Credentials login works without these values.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google reCAPTCHA v2 checkbox. Set both values together.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mock mode guarantees local tests do not contact cloud services.
INTEGRATION_MODE=mock
ALLOW_MOCK_CHECKOUT=true
FREE_ENROLLMENT_ENABLED=false
SHOW_DEMO_CREDENTIALS=true
# Optional: curated personalization remains fully functional without an API key.
AI_PERSONALIZATION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEND_API_KEY=
EMAIL_FROM=AI Literacy <noreply@localhost>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
ADMIN_PREVIEW_ENABLED=true
ADMIN_TRIGGER_SECRET=replace-with-a-long-random-value
SEED_PASSWORD=ChangeMe123!
